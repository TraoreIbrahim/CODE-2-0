{
  "name": "@code/desktop",
  "productName": "CODE 2.0",
  "version": "0.1.0",
  "private": true,
  "description": "CODE 2.0 — app de bureau (macOS, Windows, Linux) : plein écran et miniature flottante",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "preview:browser": "vite --config vite.browser.config.ts",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@code/protocol": "*",
    "@code/ui": "*",
    "@types/node": "^24.9.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.1.12"
  }
}
